{
  "name": "chameleon-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server/app.js && node --check server/index.js && node --check server/db.js && node --check games.js && node --test test/*.test.js",
    "build": "node server/build.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
